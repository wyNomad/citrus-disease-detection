<?xml version="1.0"?>
<package format="3">
  <name>citrus_detector</name>
  <version>0.1.0</version>
  <description>Citrus vision ROS 2 adapter using the shared citrus_vision source</description>
  <maintainer email="175272477+wyNomad@users.noreply.github.com">wyNomad</maintainer>
  <license>LicenseRef-Unspecified</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>citrus_vision</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>citrus_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
